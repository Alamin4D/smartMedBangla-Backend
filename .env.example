# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin(s), comma separated – used for CORS and links in emails
CLIENT_URL=http://localhost:3000
# Public URL of this API – used for SSLCommerz callbacks
API_PUBLIC_URL=http://localhost:5000

# ─── Database (PostgreSQL – Neon / Supabase / Render / local) ─────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartmed?schema=public

# ─── Auth ─────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ─── AI (at least one provider) ───────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional fallback provider
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ─── Cloudinary (prescription & medicine strip images) ────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Redis (BullMQ jobs + cache). Optional: falls back to node-cron + memory cache
REDIS_URL=

# ─── Email (OTP, caregiver alerts). Gmail: use an App Password ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartMed <no-reply@smartmed.app>

# ─── Web Push (generate: npx web-push generate-vapid-keys) ─────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@smartmed.app

# ─── SSLCommerz (sandbox: https://developer.sslcommerz.com/registration/) ─────
SSLC_STORE_ID=
SSLC_STORE_PASSWORD=
SSLC_IS_LIVE=false
PREMIUM_PRICE_BDT=199

# ─── Business rules ───────────────────────────────────────
FREE_AI_SCANS_PER_MONTH=5
MISSED_DOSE_GRACE_MINUTES=30
ENABLE_JOBS=true

# ─── Seed (npm run db:seed) ───────────────────────────────
ADMIN_NAME=SmartMed Admin
ADMIN_EMAIL=admin@smartmed.app
ADMIN_PASSWORD=Admin@12345
